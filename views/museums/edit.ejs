<% layout('layouts/boilerplate') %>

<form action="/museums/<%= museum._id %>?_method=PUT" method="POST">
    <div>
        <label for="">Name</label>
        <input type="text" name="museum[name]" id="name" value="<%= museum.name %>">
    </div>
    <div>
        <label for="">Description</label>
        <input type="text" name="museum[description]" id="description" value="<%= museum.description %>">
    </div>
    <div>
        <label for="">Website</label>
        <input type="text" name="museum[website]" id="website" value="<%= museum.website %>">
    </div>
    <div>
        <label for="">Location</label>
        <input type="text" name="museum[location]" id="location" value="<%= museum.location %>">
    </div>
    <button>Update Museum</button>
</form>
<div>
    <a href="/museums/<%= museum._id %>">Back To Museum</a>
</div>
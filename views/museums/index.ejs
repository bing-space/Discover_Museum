<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Museum</title>
</head>
<body>
    <h1>All Museums</h1>
    <div>
        <a href="/museums/new">New Museum</a>
    </div>
    <ul>
        <% for (let museum of museums){ %>
        <li><a href="/museums/<%= museum._id %>"><%= museum.name %></a></li>
        <% } %>
    </ul>
</body>
</html>
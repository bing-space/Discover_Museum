<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Show Museum</title>
</head>
<body>
    <h1><%= museum.name %></h1>
    <h4>Description:</h4> <p><%= museum.description %></p>
    <h4>Website:</h4> <p><%= museum.website %></p>
    <h4>Location:</h4> <p><%= museum.location %></p>

    <div>
        <form action="/museums/<%= museum._id %>?_method=DELETE" method="POST">
            <button>Delete Museum</button>
        </form>
    </div>

    <footer>
        <a href="/museums/<%= museum._id %>/edit">Edit Museum</a>
        <a href="/museums">All Museums</a>
    </footer>
</body>
</html>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Museum</title>
</head>
<body>
    <form action="/museums" method="POST">
        <div>
            <label for="">Name</label>
            <input type="text" name="museum[name]" id="name">
        </div>
        <div>
            <label for="">Description</label>
            <input type="text" name="museum[description]" id="description">
        </div>
        <div>
            <label for="">Website</label>
            <input type="text" name="museum[website]" id="website">
        </div>
        <div>
            <label for="">Location</label>
            <input type="text" name="museum[location]" id="location">
        </div>
        <button>Add Museum</button>
    </form>
    <div>
        <a href="/museums">All Museums</a>
    </div>
</body>
</html>